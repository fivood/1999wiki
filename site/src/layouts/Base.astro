---
import { BASE } from '../utils/base';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 导航高亮用的顶层路径，如 /角色 */
  active?: string;
}

const { title, description = '《重返未来：1999》剧情档案馆 —— 主线、活动、角色与世界观的非官方整理', active = '' } = Astro.props;

const NAV = [
  { href: '/剧情概要', label: '剧情概要' },
  { href: '/角色', label: '角色' },
  { href: '/世界观', label: '世界观' },
  { href: '/组织', label: '组织' },
  { href: '/地点', label: '地点' },
  { href: '/轶事', label: '轶事' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a0d14'/%3E%3Cpath d='M16 5 27 16 16 27 5 16Z' fill='none' stroke='%23c9a45c' stroke-width='2'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title} · 暴雨档案馆</title>
    <ClientRouter />
  </head>
  <body>
    <div class="vignette" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <header class="nav">
      <div class="nav-inner">
        <a class="nav-brand" href={BASE + '/'}>
          <span class="brand-mark">◆</span>
          <span class="brand-zh">暴雨档案馆</span>
          <span class="brand-en">The Storm Archive</span>
        </a>
        <button class="nav-toggle" aria-label="菜单" aria-expanded="false">☰</button>
        <nav class="nav-links" id="nav-links">
          {NAV.map((n) => (
            <a href={BASE + n.href} class={active === n.href ? 'active' : ''} aria-current={active === n.href ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div>
          <span style="color: var(--gold)">◆</span> 暴雨档案馆 · The Storm Archive —— 非官方同人剧情整理，版权归深蓝互动 BLUEPOCH 所有
        </div>
        <div>
          <a href="https://github.com/fivood/1999wiki" rel="noopener">内容源 1999wiki</a>
          {' · '}
          <a href="https://1999.fivood.com" rel="noopener">旧站</a>
        </div>
      </div>
    </footer>

    <script>
      // 移动端菜单 + 滚动浮现（兼容 View Transitions：每次换页后重新绑定）
      function initPage() {
        const toggle = document.querySelector('.nav-toggle');
        const links = document.querySelector('.nav-links');
        toggle?.addEventListener('click', () => {
          const open = links?.classList.toggle('open');
          toggle.setAttribute('aria-expanded', String(!!open));
        });
        links?.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => links.classList.remove('open')),
        );

        const io = new IntersectionObserver(
          (es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
          { threshold: 0.12 },
        );
        document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
